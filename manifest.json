{
  "manifest_version": 3,
  "name": "New Tab at Top",
  "version": "1.0.0",
  "description": "Opens new tabs at the top of vertical side bar",
  "permissions": [
    "tabs",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
